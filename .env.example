# PREDIC · configuração do servidor (copie para .env e preencha)

# Chave da API Anthropic (console.anthropic.com > API Keys). Obrigatória para a IA.
ANTHROPIC_API_KEY=

# Modelo da IA (padrão: o mais capaz da linha Opus)
PREDIC_MODEL=claude-opus-5-5

# Porta e endereço. Use HOST=0.0.0.0 para acessar de outros computadores/servidor.
PORT=8787
HOST=127.0.0.1

# Chave de acesso para proteger a IA quando o servidor estiver na internet.
# Cada usuário informa esta chave em Configurações. Deixe vazio para uso local.
PREDIC_ACCESS_KEY=

# Limite de chamadas de IA por IP por hora
PREDIC_RATE_PER_HOUR=150

# Pesquisa na web pelo assistente (on/off)
PREDIC_WEB_SEARCH=on
